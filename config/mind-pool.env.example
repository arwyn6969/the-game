# Copy to .env.local for private development. Keys stay on the server.
# Never prefix these keys with VITE_ or paste them into chat.
MIND_PROVIDER_MODE=pool
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Optional existing Postgres database, needed for multiple server instances:
# DATABASE_URL=
# Production uses this JSON environment variable instead of a local file:
# MIND_POOL_CONFIG=
