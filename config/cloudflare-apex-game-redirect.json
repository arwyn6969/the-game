{
  "description": "Send apex game links to the canonical www game",
  "expression": "(http.host eq \"arwyn.party\" and (http.request.uri.path eq \"/thegame\" or starts_with(http.request.uri.path, \"/thegame/\")))",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "target_url": {
        "expression": "concat(\"https://www.arwyn.party\", http.request.uri.path)"
      },
      "status_code": 307,
      "preserve_query_string": true
    }
  },
  "enabled": true
}
